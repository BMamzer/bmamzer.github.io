    {
      "id": "legends-of-amberland",
      "title": "Legends of Amberland",
      "subtitle": "The Forgotten Crown",
      "tagline": "A love letter to 90s party RPGs.",
      "summary": "A classic first-person, turn-based party RPG you play fully offline. Pay once: no ads, no in-app purchases, no endless grind.",
      "description": [
        "A royal wizard uncovers a forgotten crown, hidden from an entire kingdom by a spell of forgetfulness. He summons seven heroes to find it and learn who erased it from memory. So begins a light, heroic, fairy-tale journey across a living open world.",
        "Grid-based movement and turn-based combat in the spirit of Might and Magic, Eye of the Beholder and the Gold Box classics, rebuilt for touch screens.",
        "Lead a party of up to seven heroes through towns, dungeons and the wilds, and play it all offline."
      ],
      "features": [
        "A party of up to seven heroes",
        "First-person, grid-based exploration",
        "Turn-based combat",
        "Open world, fully offline",
        "Pay once: no ads, no in-app purchases"
      ],
